[Unit]
Description=Taskflow AI lockdown DNS sinkhole (dnsmasq)
Documentation=file:///home/yassine/code/taskflow/governance/network-lockdown/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/taskflow/dnsmasq-main.conf --conf-file=/etc/taskflow/ai-sinkhole.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
