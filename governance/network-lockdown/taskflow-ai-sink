#!/bin/bash
# taskflow-ai-sink — root decision engine for the daily AI budget.
#
# Unlike taskflow-ai-window there is NO command to "enable" AI. Instead a systemd
# timer calls this every 60 seconds; it reads the governance verdict
# (`verify-governance --check-ai-budget`) and keeps DNS consistent:
#   open=true  -> ai-sinkhole.conf is a comment-only file   (AI resolves)
#   open=false -> ai-sinkhole.conf is the full blocklist     (AI -> 0.0.0.0 / ::)
#
# Semantics (all enforced by the same policy functions the commit gate uses):
#   CLOSED until daily deliberate practice is done
#   CLOSED during curfew (23:00-07:00)
#   CLOSED once the 120-minute daily AI budget is consumed
#   CLOSED once today's single AI session has concluded (mid-session stays open)
#   Otherwise: OPEN — no prompts, no commands, no window management.
#
# Safety: any error -> fails CLOSED. Only state *changes* rewrite the config or
# reload dnsmasq. Emergency stop: `sudo taskflow-ai-sink close`.

set -uo pipefail

STATE_DIR=${TASKFLOW_STATE_DIR:-/var/lib/taskflow}
STATE_FILE=$STATE_DIR/sink-state
SINK_CONF=${TASKFLOW_SINK_CONF:-/etc/taskflow/ai-sinkhole.conf}
BLOCKLIST=${TASKFLOW_BLOCKLIST:-/etc/taskflow/ai-blocklist.txt}
VG=${TASKFLOW_VG:-/home/yassine/code/taskflow/governance/verify-governance}
PY=/usr/bin/python3
VG_HOME=${TASKFLOW_HOME:-/home/yassine}   # timer runs as root: ~ must mean yassine, not root
GIT_ENV=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*')  # yassine-owned repos would read as dubious ownership for uid 0
LOG=${TASKFLOW_LOG:-/var/log/taskflow/ai-sink.log}
SKIP_RELOAD=${TASKFLOW_SKIP_RELOAD:-0}

ts() { date -Iseconds; }
log() { mkdir -p "$(dirname "$LOG")" 2>/dev/null; echo "$(ts) $*" | tee -a "$LOG" >&2; }

write_sinkhole() {
    : > "$SINK_CONF"
    echo "# AI daily budget EXHAUSTED or practice pending. Managed by taskflow-ai-sink." >> "$SINK_CONF"
    while IFS= read -r domain; do
        [[ -z "$domain" || "$domain" == \#* ]] && continue
        echo "address=/$domain/0.0.0.0" >> "$SINK_CONF"
        echo "address=/$domain/::" >> "$SINK_CONF"
    done < "$BLOCKLIST"
}

write_open() {
    : > "$SINK_CONF"
    echo "# AI budget available. Managed by taskflow-ai-sink (auto-flips with the daily allowance)." >> "$SINK_CONF"
}

reload_dnsmasq() {
    [[ "$SKIP_RELOAD" == "1" ]] && return 0
    systemctl reload taskflow-dnsmasq 2>/dev/null || systemctl restart taskflow-dnsmasq
}

enforce() {
    mkdir -p "$STATE_DIR"
    cur=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    # State file is only trustworthy if the sinkhole conf exists and matches it:
    if [[ ! -s "$SINK_CONF" ]]; then
        cur=unknown
    elif [[ "$cur" == "closed" ]] && ! grep -q '^address=' "$SINK_CONF"; then
        cur=unknown
    fi

    elig_json=$(HOME="$VG_HOME" env "${GIT_ENV[@]}" "$PY" "$VG" --check-ai-budget 2>/dev/null) || elig_json=""
    # Root needs git to read yassine's repos (safe.directory) and HOME to find her caches;
    # both are injected via env(1), so the verdict under the timer matches hers exactly.
    # Note: env-prefix assignments must come from `env` — bash won't recognize
    # expanded words like $arr[@] as assignment prefixes.
    if [[ -z "$elig_json" ]]; then
        log "verdict unavailable (verify-governance failed) -> closing"
        write_sinkhole; reload_dnsmasq; echo closed > "$STATE_FILE"; chmod 0644 "$STATE_FILE"; exit 1
    fi
    open=$(printf '%s' "$elig_json" | "$PY" -c 'import json,sys; print(json.load(sys.stdin).get("open", False))' 2>/dev/null || echo False)

    if [[ "$open" == "True" ]]; then
        if [[ "$cur" != "open" ]]; then
            write_open; reload_dnsmasq; echo open > "$STATE_FILE"; chmod 0644 "$STATE_FILE"
            log "OPEN — budget available: $(printf '%s' "$elig_json")"
        fi
    else
        if [[ "$cur" != "closed" ]]; then
            write_sinkhole; reload_dnsmasq; echo closed > "$STATE_FILE"; chmod 0644 "$STATE_FILE"
            log "CLOSED — reasons: $(printf '%s' "$elig_json" | "$PY" -c 'import json,sys; print(", ".join(json.load(sys.stdin).get("reasons", ["unknown"])))')"
        fi
    fi
}

case "${1:-enforce}" in
  enforce)
    enforce
    ;;
  close)   # emergency stop — removes AI access until the policy allows it again
    mkdir -p "$STATE_DIR"
    write_sinkhole; reload_dnsmasq; echo closed > "$STATE_FILE"; chmod 0644 "$STATE_FILE"
    log "CLOSED manually (taskflow-ai-sink close)"
    ;;
  open)    # deliberately unrestricted escape hatch? NO. Refused — use sudo to uninstall instead.
    log "OPEN refused — this command deliberately does nothing. Uninstall for a clean break."
    echo "this command deliberately cannot open AI access; it is policy-driven only." >&2
    exit 1
    ;;
  status)
    echo "state: $(cat "$STATE_FILE" 2>/dev/null || echo unknown) (last budget verdict:)"
    HOME="$VG_HOME" env "${GIT_ENV[@]}" "$PY" "$VG" --check-ai-budget 2>/dev/null | "$PY" -m json.tool
    ;;
  *)
    echo "usage: taskflow-ai-sink {enforce|close|status}" >&2
    exit 2
    ;;
esac
