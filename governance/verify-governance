        except Exception:
            pass
        return 1
    return 0

BLOCK_ONE_MAX_MIN = 60
COOLDOWN_MIN = 120
DAILY_CAP_MIN = 120

def two_block_verdict(daily_minutes, last_ai_event_ts, now):
    """Daily AI allowance as two 60-minute blocks separated by a 2-hour silence.
    Block 1: AI open while daily < 60 min. Block 2: opens only after >= 120 minutes
    with NO AI events, capped at 120 min total. Governance day resets at 07:00.
    Returns (reasons, info) — reasons empty means the budget allows AI right now."""
    reasons = []
    now_ts = int(now.timestamp())
    minutes_since_last_ai = int((now_ts - last_ai_event_ts) // 60) if last_ai_event_ts else None
    time_in_cooldown = daily_minutes >= BLOCK_ONE_MAX_MIN and daily_minutes < DAILY_CAP_MIN
    cooling_down = time_in_cooldown and not (minutes_since_last_ai is not None and minutes_since_last_ai >= COOLDOWN_MIN)

    if daily_minutes >= DAILY_CAP_MIN:
        reasons.append(f"HEALTH-003: daily cap reached ({daily_minutes} min / {DAILY_CAP_MIN} min)")
        status = "spent"
    elif cooling_down:
        remaining = COOLDOWN_MIN - (minutes_since_last_ai if minutes_since_last_ai is not None else 0)
        reasons.append(
            f"HEALTH-002C: first 60-minute AI block spent ({daily_minutes} min used); "
            f"second block opens after 120 min of silence — {remaining} min of cooldown remaining"
        )
        status = "cooldown"
    else:
        status = "block_1" if daily_minutes < BLOCK_ONE_MAX_MIN else "block_2"

    info = {
        "ai_block": status,
        "minutes_since_last_ai_event": minutes_since_last_ai,
        "cooldown_remaining_minutes": (COOLDOWN_MIN - minutes_since_last_ai)
        if (cooling_down and minutes_since_last_ai is not None) else None,
    }
    return reasons, info

def ai_window_eligible():
    """Machine-readable eligibility for opening the 120-minute AI network window.
    Used by /usr/local/sbin/taskflow-ai-window (root, NOPASSWD sudoers entry).
    Prints JSON; always exits 0 (it is a query, not a gate).
    """
    now = datetime.now()
    reasons = []

    daily_minutes, session_minutes, session_end_timestamp, sessions_completed, in_active_session, last_ai_event_ts = get_session_and_daily_minutes("deep_work")

    # CURFEW
    if now.hour >= 23 or now.hour < 7:
        reasons.append(f"HEALTH-001: curfew active ({now.hour}:00)")

    # PRACTICE FIRST
    if not exercises_done_today():
        reasons.append("PRACTICE-001: daily deliberate practice not completed")

    # TWO-BLOCK DAILY BUDGET (60 min, 2h silence, 60 min)
    block_reasons, block_info = two_block_verdict(daily_minutes, last_ai_event_ts, now)
    reasons.extend(block_reasons)

    eligible = len(reasons) == 0
    print(json.dumps({
        "eligible": eligible,
        "reasons": reasons,
        "daily_ai_minutes": daily_minutes,
        "sessions_completed": sessions_completed,
        "in_active_session": in_active_session,
        "session_minutes": session_minutes,
        **block_info,
        "as_of": int(now.timestamp())
    }))

def ai_budget_open():
    """Machine-readable daily-budget verdict for the sinkhole enforcer.
    Used by /usr/local/sbin/taskflow-ai-sink (root, run by systemd timer every minute).
    Prints JSON; always exits 0. Semantics: AI is reachable inside the daily budget —
    two 60-minute blocks per governance day separated by 120 minutes of silence.
    Practice-first, under the 120-minute cap, not in curfew. No command is required.
    """
    now = datetime.now()
    reasons = []

    daily_minutes, session_minutes, session_end_timestamp, sessions_completed, in_active_session, last_ai_event_ts = get_session_and_daily_minutes("deep_work")

    # CURFEW — before 07:00 or after 23:00
    if now.hour >= 23 or now.hour < 7:
        reasons.append(f"HEALTH-001: curfew ({now.hour}:00)")

    # PRACTICE FIRST
    if not exercises_done_today():
        reasons.append("PRACTICE-001: daily deliberate practice not completed")

    # TWO-BLOCK DAILY BUDGET (60 min, 2h silence, 60 min)
    block_reasons, block_info = two_block_verdict(daily_minutes, last_ai_event_ts, now)
    reasons.extend(block_reasons)

    print(json.dumps({
        "open": len(reasons) == 0,
        "reasons": reasons,
        "daily_ai_minutes": daily_minutes,
        "sessions_completed": sessions_completed,
        "in_active_session": in_active_session,
        "session_minutes": session_minutes,
        **block_info,
        "as_of": int(now.timestamp())
    }))

def main():
    if not os.path.exists(OPA_BIN):
        print("🛑 Policy engine error — failing closed: OPA binary not found at ~/.local/bin/opa", file=sys.stderr)
        sys.exit(1)
    if not os.path.exists(POLICY_FILE):
        print("🛑 Policy engine error — failing closed: governance.rego not found", file=sys.stderr)
        sys.exit(1)

    project = os.path.basename(os.getcwd())
    now = datetime.now()

    # Determine activity type: deep_work vs vibe_coding
    has_deepwork_signatures = os.path.isdir("Makefile") or os.path.isdir("tests") or os.path.isdir("src") or os.path.isdir("c_src") or os.path.isdir("vendor")
    activity_type = "deep_work" if project == "practice" else ("vibe_coding" if not has_deepwork_signatures else "deep_work")

    daily_minutes, session_minutes, session_end_timestamp, sessions_completed, in_active_session, last_ai_event_ts = get_session_and_daily_minutes(activity_type)

    # Governance day starts at 7:00 AM (not calendar midnight)
    if now.hour >= 7:
        governance_day_str = now.strftime("%Y-%m-%d")
    else:
        # Previous calendar day but still governance day
        governance_day_str = (now - timedelta(days=1)).strftime("%Y-%m-%d")

    exercises_done = exercises_done_today()

    # Calculate minutes since last session ended (if any)
    minutes_since_last_session_end = None
    if session_end_timestamp:
        minutes_since_last_session_end = int((int(now.timestamp()) - session_end_timestamp) // 60)

    # Minutes since the most recent AI event of ANY kind (drives HEALTH-002C)
    minutes_since_last_ai_event = None
    if last_ai_event_ts:
        minutes_since_last_ai_event = int((int(now.timestamp()) - last_ai_event_ts) // 60)

    eval_input = {
        "project": project,
        "activity_type": activity_type,
        "current_hour": now.hour,
        "daily_project_minutes": daily_minutes,
        "session_minutes": session_minutes,
        "daily_exercises_done": exercises_done,
        "timestamp": int(now.timestamp()),
        "session_end_timestamp": session_end_timestamp,
        "minutes_since_last_session_end": minutes_since_last_session_end,
        "minutes_since_last_ai_event": minutes_since_last_ai_event,
        "sessions_completed": sessions_completed,
        "in_active_session": in_active_session
    }

    try:
        cmd = [
            OPA_BIN, "eval", "--format", "raw",
            "--data", POLICY_FILE,
            "--stdin-input",
            "data.policy.governance.deny"
        ]
        proc = subprocess.run(
            cmd,
            input=json.dumps(eval_input).encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True
        )
        raw_out = proc.stdout.decode("utf-8").strip()
        violations = json.loads(raw_out) if raw_out else []
    except Exception as e:
        # Fail-closed: if OPA evaluation fails for any reason, deny rather than silently allow
        print(f"🛑 Policy engine error — failing closed: {e}", file=sys.stderr)
        sys.exit(1)

    if violations:
        RED = "\033[1;31m"
        YELLOW = "\033[1;33m"
        CYAN = "\033[1;36m"
        RESET = "\033[0m"

        print(f"\n{RED}🛑 HEALTH & GOVERNANCE POLICY VIOLATION{RESET}", file=sys.stderr)
        print(f"{YELLOW}Project: {project} | Activity: {activity_type} | Total AI Minutes (agentic + browser): {daily_minutes} | Current Time: {now.strftime('%H:%M')}{RESET}", file=sys.stderr)
        for v in violations:
            print(f"  {RED}✖{RESET} {v}", file=sys.stderr)
        print(f"\n{CYAN}Take care of your health first. Rest and recovery are mandatory for high performance.{RESET}\n", file=sys.stderr)
        sys.exit(1)

    return 0

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--check-ai-window":
        ai_window_eligible()
        sys.exit(0)
    if len(sys.argv) > 1 and sys.argv[1] == "--check-ai-budget":
        ai_budget_open()
        sys.exit(0)
    sys.exit(main())
