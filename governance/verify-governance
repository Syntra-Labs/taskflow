def is_agentic_entry(entry):
    """
    Identifies agentic tool usage from Antigravity transcripts.
    (Conversational AI via the browser counts separately as dwell segments,
    reconstructed from Chrome history.)
    """
    tool_calls = entry.get("tool_calls")
    if tool_calls and isinstance(tool_calls, list) and len(tool_calls) > 0:
        return True
    step_type = entry.get("type")
    if step_type in ("TOOL_CALL", "TOOL_RESPONSE", "GENERIC"):
        return True
    return False

def get_browser_ai_segments():
    """Return [(start_unix, end_unix), ...] of browser AI usage for the current governance day.
    Reuses the taskflow tracker's dwell reconstruction (single source of truth).
    Returns [] if the tracker is unavailable.
    """
    try:
        tracker_path = os.path.join(BASE_DIR, "..", "tracker", "tracker.py")
        if not os.path.exists(tracker_path):
            return []
        import importlib.util
        spec = importlib.util.spec_from_file_location("taskflow_tracker", tracker_path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod.get_ai_segments() or []
    except Exception as e:
        print(f"⚠️  Browser AI usage source unavailable: {e}", file=sys.stderr)
        return []

def gather_git_events(activity_type, gov_start, gov_start_ts):
    """Commit timestamps (as zero-width events) for vibe-coding activity."""
    events = []
    if activity_type == "vibe_coding":
        try:
            today_str = gov_start.strftime("%Y-%m-%d %H:%M:%S")
            out = subprocess.check_output(
                ["git", "log", f"--since={today_str}", "--reverse", "--format=%at"],
                stderr=subprocess.DEVNULL,
                text=True
            ).strip()
            if out:
                for t in out.splitlines():
                    if t.strip():
                        ts = int(t)
                        if ts >= gov_start_ts:
                            events.append((ts, ts))
        except Exception:
            pass
    return events

def gather_antigravity_events(gov_start_ts):
    """Timestamps of agentic tool calls (as zero-width events)."""
    events = []
    try:
        import glob
        brain_dir = os.path.expanduser("~/.gemini/antigravity-cli/brain")
        transcripts = glob.glob(os.path.join(brain_dir, "*", ".system_generated", "logs", "transcript.jsonl"))
        active_transcripts = [t for t in transcripts if os.path.getmtime(t) >= gov_start_ts]
        for t_file in active_transcripts:
            with open(t_file, "r") as f:
                for line in f:
                    if not line.strip(): continue
                    try:
                        entry = json.loads(line)
                        if is_agentic_entry(entry):
                            cat = entry.get("created_at")
                            if cat:
                                dt = datetime.fromisoformat(cat.replace("Z", "+00:00"))
                                ts = int(dt.timestamp())
                                if ts >= gov_start_ts:
                                    events.append((ts, ts))
                    except Exception:
                        pass
    except Exception:
        pass
    return events

def gather_opencode_events(gov_start_ts):
    """Timestamps of OpenCode agent activity (all non-user messages, as zero-width events).

    Reads ~/.local/share/opencode/opencode.db read-only (WAL mode supports
    concurrent readers). Message *content* is never read or logged — only
    timestamps. In a user's OpenCode workflow this covers this very session.
    """
    events = []
    try:
        import sqlite3
        db = os.path.expanduser("~/.local/share/opencode/opencode.db")
        if not os.path.exists(db):
            return events
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        rows = conn.execute(
            "SELECT time_created FROM session_message WHERE type != 'user' AND time_created >= ?",
            (gov_start_ts * 1000,)  # stored in milliseconds
        ).fetchall()
        conn.close()
        for (ts_ms,) in rows:
            events.append((int(ts_ms // 1000), int(ts_ms // 1000)))
    except Exception as e:
        print(f"⚠️  OpenCode usage source unavailable: {e}", file=sys.stderr)
    return events

def gather_browser_ai_events(gov_start_ts):
    """Browser AI usage (dwell segments) from Chrome history."""
    events = []
    try:
        for s, e in get_browser_ai_segments():
            if e >= gov_start_ts:
                events.append((max(s, gov_start_ts), e))
    except Exception:
        pass
    return events

SESSION_GAP_SECONDS = 30 * 60

def cluster_events(events, now_ts):
    """Cluster (start, end) events into sessions separated by > 30 min.
    Returns (daily_minutes, session_minutes, last_session_end,
             sessions_completed, in_active_session, last_ai_event_ts).
    """
    events = sorted(set(events))

    if not events:
        return 0, 0, None, 0, False, None

    sessions = []
    cur_start, cur_end = events[0]
    for s, e in events[1:]:
        if (s - cur_end) > SESSION_GAP_SECONDS:
            sessions.append((cur_start, cur_end))
            cur_start, cur_end = s, e
        else:
            cur_end = max(cur_end, e)
    sessions.append((cur_start, cur_end))

    last_event = sessions[-1][1]
    if (now_ts - last_event) <= SESSION_GAP_SECONDS:
        in_active_session = True
        active_session_start = sessions[-1][0]
        session_minutes = max(1, (now_ts - active_session_start) // 60)
        sessions_completed = len(sessions) - 1
        last_session_end = sessions[-2][1] if len(sessions) > 1 else None
    else:
        in_active_session = False
        session_minutes = 0
        sessions_completed = len(sessions)
        last_session_end = last_event

    daily_minutes = 0
    for i, (s, e) in enumerate(sessions):
        if in_active_session and i == len(sessions) - 1:
            daily_minutes += max(1, (now_ts - s) // 60)
        else:
            daily_minutes += max(1, (e - s) // 60)

    last_ai_event_ts = sessions[-1][1]
    return daily_minutes, session_minutes, last_session_end, sessions_completed, in_active_session, last_ai_event_ts

def get_session_and_daily_minutes(activity_type="deep_work"):
    now = datetime.now()
    now_ts = int(now.timestamp())

    # Governance day starts at 7:00 AM; if before 7 AM, yesterday's 7 AM is the boundary
    if now.hour >= 7:
        gov_start = now.replace(hour=7, minute=0, second=0, microsecond=0)
    else:
        gov_start = (now - timedelta(days=1)).replace(hour=7, minute=0, second=0, microsecond=0)
    gov_start_ts = int(gov_start.timestamp())

    events = []
    events += gather_git_events(activity_type, gov_start, gov_start_ts)
    events += gather_antigravity_events(gov_start_ts)
    events += gather_opencode_events(gov_start_ts)
    events += gather_browser_ai_events(gov_start_ts)

    return cluster_events(events, now_ts)

def check_leetcode_today():
    import urllib.request
    try:
        query = {
            "query": "query recentSubmissions($username: String!, $limit: Int!) { recentSubmissionList(username: $username, limit: $limit) { timestamp } }",
            "variables": {"username": LEETCODE_USERNAME, "limit": 10}
        }
        req = urllib.request.Request(
            "https://leetcode.com/graphql",
            data=json.dumps(query).encode("utf-8"),
            headers={"Content-Type": "application/json", "User-Agent": "GovernancePolicy/1.0"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            subs = data.get("data", {}).get("recentSubmissionList", [])
            today_date = datetime.now().date()
            for sub in subs:
                ts = int(sub.get("timestamp", 0))
                sub_date = datetime.fromtimestamp(ts).date()
                if sub_date == today_date:
                    return True
    except Exception:
        pass
    return False

def check_codeforces_today():
    import urllib.request
    try:
        today_date = datetime.now().date()
        for handle in CODEFORCES_HANDLES:
            url = f"https://codeforces.com/api/user.status?handle={handle}&from=1&count=10"
            req = urllib.request.Request(url, headers={"User-Agent": "GovernancePolicy/1.0"})
            with urllib.request.urlopen(req, timeout=3) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("status") == "OK":
                    for sub in data.get("result", []):
                        ts = int(sub.get("creationTimeSeconds", 0))
                        sub_date = datetime.fromtimestamp(ts).date()
                        if sub_date == today_date and sub.get("verdict") == "OK":
                            return True
    except Exception:
        pass
    return False

def check_deepml_today():
    import urllib.request, re
    try:
        url = f"https://www.deep-ml.com/profile/{DEEPML_USER_ID}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            html = resp.read().decode("utf-8")
        
        m = re.search(r"(\d+)\s+problems\s+solved", html)
        if not m:
            return False
        current_solved = int(m.group(1))
        today_str = datetime.now().strftime("%Y-%m-%d")

        state = {}
        if os.path.exists(DEEPML_STATE_FILE):
            try:
                with open(DEEPML_STATE_FILE, "r") as f:
                    state = json.load(f)
            except Exception:
                pass

        last_date = state.get("last_check_date")
        base_solved = state.get("base_solved_count", current_solved)

        # If it is a new day, initialize today base count
        if last_date != today_str:
            state["last_check_date"] = today_str
            state["base_solved_count"] = current_solved
            with open(DEEPML_STATE_FILE, "w") as f:
                json.dump(state, f)
            return False

        # If solved count increased today
        if current_solved > base_solved:
            return True
    except Exception:
        pass
    return False

def check_local_practice_today():
    """A local practice session counts only when ~/code/practice has a git commit
    since governance-day start (07:00) that includes at least one *_test.cpp file.

    The practice pre-commit hook guarantees that such a commit can only land if
    every staged test compiled AND exited 0 — so the commit is proof of a completed,
    verified solution.
    """
    try:
        if not os.path.exists(PRACTICE_DIR):
            return False

        # Confirm it is a git repo
        probe = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            cwd=PRACTICE_DIR, capture_output=True, text=True
        )
        if probe.returncode != 0:
            return False

        # Governance day starts at 07:00
        now = datetime.now()
        if now.hour >= 7:
            gov_start = now.replace(hour=7, minute=0, second=0, microsecond=0)
        else:
            gov_start = (now - timedelta(days=1)).replace(hour=7, minute=0, second=0, microsecond=0)
        since_str = gov_start.strftime("%Y-%m-%dT%H:%M:%S")

        # List files touched in commits since governance day start
        log = subprocess.run(
            ["git", "log", f"--since={since_str}", "--name-only", "--format="],
            cwd=PRACTICE_DIR, capture_output=True, text=True
        )
        if log.returncode != 0:
            return False

        for line in log.stdout.splitlines():
            if line.strip().endswith("_test.cpp"):
                return True
    except Exception:
        pass
    return False

